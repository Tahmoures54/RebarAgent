# RebarAgent worker / sales environment (copy to .env and fill in).
# The desktop app and tools/usdt_license_bot.py both read this file at start.
# Do not commit a filled .env.

# --- Receive wallet (USDT on TRC20 / Tron) ---
REBARAGENT_USDT_TRC20=

# --- Sales worker (Telegram bot or landing page) ---
REBARAGENT_WORKER_URL=
REBARAGENT_TELEGRAM=@RebarAgent
REBARAGENT_TELEGRAM_BOT_TOKEN=
REBARAGENT_WHATSAPP=+989160684552

# --- Plan prices (USDT ≈ USD). Empty = built-in defaults. ---
REBARAGENT_PRICE_PRO_3M_USD=49
REBARAGENT_PRICE_PRO_6M_USD=79
REBARAGENT_PRICE_PRO_1Y_USD=129
REBARAGENT_PRICE_OFFICE_1Y_USD=249
REBARAGENT_PRICE_UNLIMITED_USD=399

REBARAGENT_PRICE_PRO_3M_IRR=2900000
REBARAGENT_PRICE_PRO_6M_IRR=4900000
REBARAGENT_PRICE_PRO_1Y_IRR=7900000
REBARAGENT_PRICE_OFFICE_1Y_IRR=14900000
REBARAGENT_PRICE_UNLIMITED_IRR=24900000

# --- Optional: TronGrid key if you hit rate limits ---
TRONGRID_API_KEY=

# --- Optional: rewrite Copilot headlines via an OpenAI-compatible API ---
REBARAGENT_AI_API_KEY=
REBARAGENT_AI_BASE_URL=https://api.openai.com/v1
REBARAGENT_AI_MODEL=gpt-4o-mini
